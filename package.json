{
  "name": "sarksh-foods-v13-production-search-secure",
  "version": "13.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/generate-seo.mjs",
    "build:prod": "node scripts/require-site-url.mjs && tsc --noEmit && vite build && node scripts/generate-seo.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "seo:generate": "node scripts/generate-seo.mjs",
    "verify:prod": "node scripts/verify-production.mjs",
    "backend:health": "node scripts/check-backend.mjs",
    "security:audit": "node scripts/audit-public-repo.mjs",
    "search:verify": "node scripts/verify-search.mjs",
    "search:live": "node scripts/check-live-search.mjs",
    "search:indexnow": "node scripts/submit-indexnow.mjs",
    "validate:prod": "npm run security:audit && npm run typecheck && npm run backend:health && npm run build:prod && npm run verify:prod && npm run search:verify"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.16",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.16"
  }
}
