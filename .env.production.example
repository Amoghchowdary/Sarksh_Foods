# Canonical production domain. Keep this exact value for public deployment.
SITE_URL=https://www.sarkshfoods.in

# GitHub Pages custom-domain deployment is served from the root.
BASE_PATH=/

# Required: deployed Google Apps Script Web App endpoint.
VITE_API_BASE_URL=https://script.google.com/macros/s/AKfycbw_nR3t5gJfE5BOB4F1NduKDL1Mm10ad73BbnXRygL9pWDm-EwqmcegcVyswZimIYTtgA/exec

# Optional: Search Console HTML-tag verification token (DNS Domain verification is preferred).
GOOGLE_SITE_VERIFICATION=
