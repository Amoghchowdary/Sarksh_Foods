# PUBLIC EXAMPLE ONLY — never put a real credential in this file.

# Canonical public domain.
SITE_URL=https://www.sarkshfoods.in

# GitHub Pages custom-domain deployment is served from root.
BASE_PATH=/

# Set the real Apps Script Web App URL as a GitHub Actions secret named:
# VITE_API_BASE_URL
# Do not commit the real deployment URL in source files.
VITE_API_BASE_URL=__SET_AS_GITHUB_ACTIONS_SECRET__

# Optional Search Console verification token.
# This token is public once rendered in HTML, so use a repository variable, not a password.
GOOGLE_SITE_VERIFICATION=

# Optional IndexNow key. This is a public verification key, not a password.
INDEXNOW_KEY=
