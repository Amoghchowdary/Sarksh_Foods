Options -Indexes
RewriteEngine On

# Canonical production hostname.
RewriteCond %{HTTP_HOST} ^sarkshfoods\.in$ [NC]
RewriteRule ^ https://www.sarkshfoods.in%{REQUEST_URI} [R=301,L]

# Serve generated route index files when present, otherwise fall back to the SPA.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
