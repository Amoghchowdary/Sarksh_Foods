# Copy to .env; never push .env to GitHub
# local-preview mode keeps the original V26 JSON backend for offline UI checks
# apps_script mode stores customers, carts, orders and enquiries in Google Sheets
SARKSH_BACKEND=local-preview
SARKSH_GAS_URL=
SARKSH_GAS_SECRET=
PORT=5242
HOST=127.0.0.1
# Set COOKIE_SECURE=true only when deployed behind HTTPS
COOKIE_SECURE=false
